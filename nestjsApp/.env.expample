# Your windows ip as seens from wsl. Check /etc/resolv.conf
OLLAMA_BASE_URL=dummy

# Ollama model with which you want to interact
MODEL_NAME=deepseek-coder-v2:16b    
# MODEL_NAME=deepseek-r1:14b

# Port on which this application will run on.
APPLICATION_PORT=3000

# Directory where voice recording will be sotred. Path is at root.
RECORDINGS_DIR=./recordings

TIMEZONE=Asia/Kolkata

# Need for transscripting audio to text
PICOVOICE_ACCESS_KEY=dummy

# To see all logs
DEBUG=true

TRANSCRIPTION_SERVER_ENDPOINT=http://0.0.0.0:5002/transcript

VOICE_SYNTHESIS_SERVER_ENDPOINT=http://localhost:5003/voice/synthesize
