    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.9",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.16",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
