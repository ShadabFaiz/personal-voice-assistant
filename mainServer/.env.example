# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Port on which this application will run on.
APPLICATION_PORT=3000

# Enable verbose logging. Set to 'true' to see all logs.
DEBUG=true

# Application timezone (IANA format).
TIMEZONE=Asia/Kolkata

# Path to custom CA certificate. Use if you are behind a proxy/VPN that requires custom certs.
CUSTOM_CA_CERT_PATH=

# Directory where voice recordings are stored. Path is relative to project root.
RECORDINGS_DIR=./recordings


# =============================================================================
# LLM MODEL SELECTION
# =============================================================================

# For Gemini
# API key from Google AI Studio: https://aistudio.google.com/apikey
# Model identifier: https://ai.google.dev/gemini-api/docs/models
MODEL_TYPE=gemini
GOOGLE_GEMINI_API_KEY=dummy
GEMINI_MODEL=gemini-2.5-flash-lite

# For Ollama
# Base URL of the Ollama server (if on WSL, use Windows IP from /etc/resolv.conf).
# Model tag must match a locally available model (run `ollama list` to see options).
#MODEL_TYPE=ollama
#OLLAMA_BASE_URL=http://localhost:11434
#MODEL_NAME=deepseek-coder-v2:16b


# =============================================================================
# WEB SEARCH ENGINE
# =============================================================================

# For Brave Search
# API key from https://brave.com/search/api/
#SEARCH_ENGINE=brave
#BRAVE_SEARCH_API_KEY=mock-api-key
#BRAVE_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search

# For SerpApi / Google
# API key from https://serpapi.com/
SEARCH_ENGINE=google
SERPAPI_API_KEY=mock-api-key


# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Speech-to-text transcription server endpoint.
TRANSCRIPTION_SERVER_ENDPOINT=http://0.0.0.0:5002/transcript
# Text-to-speech voice synthesis server endpoint.
VOICE_SYNTHESIS_SERVER_ENDPOINT=http://localhost:5003/voice/synthesize


# =============================================================================
# AGENT CONFIGURATION
# =============================================================================
# Do not change these unless you have custom prompt files.
SYSTEM_PROMPTS_DIRECTORY=systemPrompts
AGENT_PERSONALITY_DIRECTORY=llmPersonalities
AGENT_PERSONALITY=LEENA.txt
ABOUT_ME_FILE_NAME=aboutMe.txt


# =============================================================================
# AGENT WORKSPACE
# =============================================================================
# Directory where the LLM can read and write files. Created relative to project root.
AGENT_WORKSPACE_DIRECTORY_NAME=agent_workspace


# =============================================================================
# LOCATION DATA
# =============================================================================
# Used by the assistant for context-aware responses (weather, timezone, local info).
# All fields are optional. Populate the ones relevant to your deployment.
LOCATION_CITY=Patna
LOCATION_REGION=Bihar
LOCATION_REGION_CODE=DL
LOCATION_COUNTRY=IN
LOCATION_COUNTRY_NAME=India
LOCATION_COUNTRY_CODE=IN
LOCATION_COUNTRY_CODE_ISO3=IND
LOCATION_COUNTRY_CAPITAL=Patna
LOCATION_COUNTRY_TLD=.in
LOCATION_CONTINENT_CODE=AS
LOCATION_IN_EU=false
LOCATION_POSTAL=110098
LOCATION_LATITUDE=28.62137
LOCATION_LONGITUDE=77.2148
LOCATION_TIMEZONE=Asia/Kolkata
LOCATION_UTC_OFFSET=+0530
LOCATION_COUNTRY_CALLING_CODE=+91
LOCATION_CURRENCY=INR
LOCATION_CURRENCY_NAME=Rupee
LOCATION_LANGUAGES=en-IN,hi,bn,te,mr,ta,ur,gu,kn,ml,or,pa,as,bh,sat,ks,ne,sd,kok,doi,mni,sit,sa,fr,lus,inc
LOCATION_COUNTRY_AREA=3287590
LOCATION_COUNTRY_POPULATION=1352617328
LOCATION_ASN=AS53813
LOCATION_ORG=ZSCALER, INC.